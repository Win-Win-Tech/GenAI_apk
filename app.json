{
  "expo": {
    "name": "Faceio",
    "slug": "trueface",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/trueface-adaptive-logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trueface.mobile.trueface",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to your camera to recognize faces for registration and attendance.",
        "NSLocationWhenInUseUsageDescription": "This app needs your location to verify your presence at the assigned location during check-in/out.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to allow you to upload profile photos.",
        "NSMicrophoneUsageDescription": "This app needs access to your microphone for video capture features.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/trueface-adaptive-logo.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.trueface.mobile.trueface"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/trueface-adaptive-logo.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/trueface-adaptive-logo.png"
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/trueface-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "fff17c96-2b2c-446a-89f8-7f63817920a0"
      }
    },
    "owner": "akshaya_muthukumar"
  }
}
